APP_NAME="InventoryOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://inventory.test

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_platform
DB_USERNAME=root
DB_PASSWORD=Hackersonlyknow262

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database

API_KEY_HEADER=X-API-Key
API_RATE_LIMIT=60
API_RATE_WINDOW=60
CORS_ALLOWED_ORIGINS=http://inventory.test,http://localhost
PASSWORD_MIN_LENGTH=12

# Production: APP_DEBUG=false, HTTPS APP_URL, SESSION_SECURE_COOKIE=true,
# strong DB credentials, explicit CORS origins, and externally managed secrets.
