@echo off\nsetlocal\nREM Set MYSQL_BIN to your XAMPP MariaDB/MySQL bin folder if needed.\nset MYSQL_BIN=C:\xampp\mysql\bin\nset DB_NAME=inventory_platform\nset DB_USER=root\nset BACKUP_DIR=storage\app\backups\database\nif not exist "%BACKUP_DIR%" mkdir "%BACKUP_DIR%"\nfor /f "tokens=1-3 delims=/ " %%a in ("%date%") do set TODAY=%%c-%%a-%%b\n"%MYSQL_BIN%\mysqldump.exe" -u %DB_USER% %DB_NAME% > "%BACKUP_DIR%\%DB_NAME%-%TODAY%.sql"\nif errorlevel 1 (echo Backup failed.& exit /b 1)\necho Backup created in %BACKUP_DIR%\n